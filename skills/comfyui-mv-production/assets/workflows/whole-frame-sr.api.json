{
  "prompt": {
    "1": {
      "class_type": "LoadVideo",
      "inputs": {
        "file": "{{sr.source_video}}"
      }
    },
    "2": {
      "class_type": "GetVideoComponents",
      "inputs": {
        "video": [
          "1",
          0
        ]
      }
    },
    "3": {
      "class_type": "ImageFromBatch",
      "inputs": {
        "image": [
          "2",
          0
        ],
        "batch_index": "{{sr.source_in}}",
        "length": "{{sr.frames}}"
      }
    },
    "4": {
      "class_type": "UpscaleModelLoader",
      "inputs": {
        "model_name": "{{sr.model}}"
      }
    },
    "5": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": {
        "upscale_model": [
          "4",
          0
        ],
        "image": [
          "3",
          0
        ]
      }
    },
    "6": {
      "class_type": "ImageScaleBy",
      "inputs": {
        "image": [
          "3",
          0
        ],
        "upscale_method": "lanczos",
        "scale_by": 2.0
      }
    },
    "7": {
      "class_type": "ImageBlend",
      "inputs": {
        "image1": [
          "6",
          0
        ],
        "image2": [
          "5",
          0
        ],
        "blend_factor": "{{sr.blend}}",
        "blend_mode": "normal"
      }
    },
    "8": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "7",
          0
        ],
        "fps": [
          "2",
          2
        ],
        "bit_depth": "auto",
        "color_space": "sRGB",
        "codec": "none"
      }
    },
    "9": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "8",
          0
        ],
        "filename_prefix": "mv/{{shot_id}}/full_frame_sr",
        "format": "mp4",
        "format.codec": "h264",
        "format.codec.encoding": "auto"
      }
    }
  },
  "extra_data": {
    "template_only": true,
    "parameterized_copy_GPU_validation": false,
    "source_family": "MiniMax H3",
    "requires_approved_sources": true
  }
}