{
  "prompt": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "{{models.unet}}",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "{{models.clip}}",
        "type": "minimax",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "{{models.video_vae}}"
      }
    },
    "4": {
      "class_type": "MiniMaxH3SigmaShift",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "shift_video": 12.0,
        "shift_audio": 3.0
      }
    },
    "5": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "{{sampling.seed}}"
      }
    },
    "6": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "res_multistep"
      }
    },
    "7": {
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "{{refine.sigmas}}"
      }
    },
    "8": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{references.first_frame}}"
      }
    },
    "9": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{references.last_frame}}"
      }
    },
    "13": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "5",
          0
        ],
        "guider": [
          "12",
          0
        ],
        "sampler": [
          "6",
          0
        ],
        "sigmas": [
          "7",
          0
        ],
        "latent_image": [
          "23",
          0
        ]
      }
    },
    "14": {
      "class_type": "LTXVSeparateAVLatent",
      "inputs": {
        "av_latent": [
          "13",
          0
        ]
      }
    },
    "15": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "14",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "16": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "15",
          0
        ],
        "fps": "{{render.fps}}",
        "bit_depth": "auto",
        "color_space": "sRGB",
        "codec": "none"
      }
    },
    "17": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "16",
          0
        ],
        "filename_prefix": "mv/{{shot_id}}/second_pass",
        "format": "mp4",
        "format.codec": "h264",
        "format.codec.encoding": "re-encode",
        "format.codec.encoding.crf": 16.0
      }
    },
    "10": {
      "class_type": "MiniMaxH3ImageToVideo",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "vae": [
          "3",
          0
        ],
        "prompt": "{{prompt}}",
        "width": "{{refine.width}}",
        "height": "{{refine.height}}",
        "length": "{{render.frames}}",
        "first_frame": [
          "8",
          0
        ],
        "last_frame": [
          "9",
          0
        ]
      }
    },
    "12": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "4",
          0
        ],
        "conditioning": [
          "10",
          0
        ]
      }
    },
    "19": {
      "class_type": "SaveLatent",
      "inputs": {
        "samples": [
          "14",
          0
        ],
        "filename_prefix": "mv/{{shot_id}}/latents/refined_video"
      }
    },
    "21": {
      "class_type": "LoadLatent",
      "inputs": {
        "latent": "{{latents.upscaled_video}}"
      }
    },
    "22": {
      "class_type": "LoadLatent",
      "inputs": {
        "latent": "{{latents.first_audio}}"
      }
    },
    "23": {
      "class_type": "LTXVConcatAVLatent",
      "inputs": {
        "video_latent": [
          "21",
          0
        ],
        "audio_latent": [
          "22",
          0
        ]
      }
    }
  },
  "extra_data": {
    "template_only": true,
    "parameterized_copy_GPU_validation": false,
    "source_family": "MiniMax H3",
    "requires_approved_sources": true
  }
}